{
  "name": "sovereign-architecture-portal",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22 <23",
    "bun": ">=1.3.14 <2"
  },
  "scripts": {
    "architecture:generate": "cd ../architecture && likec4 codegen react --outfile ../portal/src/generated/likec4.generated.js",
    "architecture:format": "cd ../architecture && likec4 format",
    "architecture:format:check": "cd ../architecture && likec4 format --check",
    "architecture:validate": "cd ../architecture && likec4 validate",
    "verify:architecture": "node ../scripts/verify-architecture.mjs",
    "verify:evidence": "node ../scripts/verify-evidence.mjs",
    "verify:graphs": "node ../scripts/verify-graphs.mjs",
    "stage:graphs": "node scripts/stage-graphs.mjs",
    "stage:project-docs": "node scripts/stage-project-docs.mjs",
    "prestart": "bun run architecture:generate && bun run stage:graphs && bun run stage:project-docs",
    "start": "docusaurus start",
    "prebuild": "bun run architecture:generate && bun run stage:graphs && bun run stage:project-docs",
    "build": "docusaurus build",
    "serve": "node scripts/serve-build.mjs",
    "clear": "docusaurus clear",
    "pretypecheck": "bun run architecture:generate",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint-cli2 '../README.md' '../CONTEXT-MAP.md' '../CONTRIBUTING.md' '../AGENTS.md' '../CLAUDE.md' '../docs/**/*.md' '../contracts/**/*.md'",
    "lint:terminology": "node ../scripts/check-terminology.mjs",
    "pretest": "bun run architecture:generate",
    "test": "vitest run",
    "pretest:e2e": "bun run architecture:generate && bun run stage:graphs",
    "test:e2e": "playwright test",
    "check:core": "bun run architecture:format:check && bun run architecture:validate && bun run verify:architecture && bun run verify:graphs && bun run lint:md && bun run lint:terminology && bun run typecheck && bun run test && bun run build",
    "check": "bun run check:core && bun run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vis-network": "9.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.60.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "27.2.0",
    "likec4": "1.58.0",
    "markdownlint-cli2": "0.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
