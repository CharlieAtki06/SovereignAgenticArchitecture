{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-agentic-architecture.dev/schemas/evidence-lock.json",
  "title": "Architecture evidence lock",
  "type": "object",
  "required": ["version", "repositories"],
  "properties": {
    "version": { "const": 1 },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "zone1", "zone2"],
      "patternProperties": {
        "^(root|zone1|zone2)$": {
          "type": "object",
          "required": ["repositoryUrl", "visibility", "commit", "localPath"],
          "properties": {
            "repositoryUrl": { "type": "string", "format": "uri" },
            "visibility": { "enum": ["public", "private"] },
            "commit": {
              "anyOf": [
                { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                { "type": "null" }
              ]
            },
            "localPath": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
