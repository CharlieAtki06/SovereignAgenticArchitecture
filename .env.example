# Root — the single config source for the full-system `make up`.
#
# podman-compose interpolates `${VAR}` from a `.env` in the directory you run the
# command in. `make up` runs both zones' composes (via `-f`) from THIS directory,
# so this one root `.env` feeds BOTH Zone 2 and the Zone 1 edge. Copy and edit:
#
#   cp .env.example .env      # gitignored; then `make up`
#
# Every var has a safe dev default in the compose files, so `make up` works with
# no `.env` at all — this file is for overriding secrets + knobs. In-network wiring
# (service-name URLs, ports, transport) is NOT here; it's baked into the compose.
#
# (Running a zone standalone from its own repo instead? Then that repo's own
#  `.env` / `.env.example` applies — this root file only drives `make up`.)

# ── Zone 2 — secrets (dev defaults shown; CHANGE for any non-local deploy) ────
ZONE2_DB_USER=zone2
ZONE2_DB_PASSWORD=zone2
ZONE2_DB_NAME=zone2
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ── Zone 2 — knobs ────────────────────────────────────────────────────────────
# Public Keycloak issuer host; MUST match the token `iss` the edge verifies.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
ZONE2_LOG_LEVEL=INFO
# Which vendor module(s) load (comma-separated "pkg.path:ClassName").
# Run ONE module at a time to avoid model ambiguity when testing.
# NHS only (default for clinical testing):
ZONE2_ENABLED_USE_CASE_MODULES=zone2.plugins.nhs.module:NhsModule
# Demo only (swap the line above for this when testing demo capabilities):
# ZONE2_ENABLED_USE_CASE_MODULES=zone2.plugins.demo.module:DemoModule
# Both (only if testing cross-module behavior; model may call the wrong tool):
# ZONE2_ENABLED_USE_CASE_MODULES=zone2.plugins.demo.module:DemoModule,zone2.plugins.nhs.module:NhsModule
# Lawful-basis purpose fallback for tokens with no `purpose` claim.
# Unset by default (tokens without a `purpose` claim are rejected unless configured).
# ZONE2_DEFAULT_PURPOSE=self_service
# Affects Zone 2's MCP resource serving of the Prefab renderer (ADR-0028).
# The desktop path (Zone 1 sidecar) always uses bundled mode regardless of this flag.
# Set to 1 for sovereign/offline deployment so Zone 2 serves the renderer from the
# bundled prefab-ui package instead of loading JS/CSS from cdn.jsdelivr.net.
PREFAB_BUNDLED_RENDERER=1

# ── Zone 1 edge (the containerised edge — Zone 1's own compose) ───────────────
ZONE1_LOG_LEVEL=INFO
ZONE1_MODEL=gemma4:e4b-it-q4_K_M
# Local transport secret the CLI sends (X-Host-Secret) — NOT identity.
ZONE1_HOST_SECRET=dev-secret
# App session TTL — how long a FastMCP app overlay session lives in Redis.
# Default 28800 (8 h); lower for short demos, raise for longer clinical shifts.
# ZONE2_APP_SESSION_TTL_SECONDS=28800

# FastMCP App overlays — surface Zone 2 Prefab app overlays in the desktop UI.
ZONE1_MCP_APPS_ENABLED=true
