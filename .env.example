# Root — the single config source for the full-system `make up`.
#
# podman-compose interpolates `${VAR}` from a `.env` in the directory you run the
# command in. `make up` runs from THIS directory, so this one root `.env` feeds
# BOTH Zone 2's compose (via `-f`) and the Zone 1 edge overlay. Copy and edit:
#
#   cp .env.example .env      # gitignored; then `make up`
#
# Every var has a safe dev default in the compose files, so `make up` works with
# no `.env` at all — this file is for overriding secrets + knobs. In-network wiring
# (service-name URLs, ports, transport) is NOT here; it's baked into the compose.
#
# (Running a zone standalone from its own repo instead? Then that repo's own
#  `.env` / `.env.example` applies — this root file only drives `make up`.)

# ── Zone 2 — secrets (dev defaults shown; CHANGE for any non-local deploy) ────
ZONE2_DB_USER=zone2
ZONE2_DB_PASSWORD=zone2
ZONE2_DB_NAME=zone2
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ── Zone 2 — knobs ────────────────────────────────────────────────────────────
# Public Keycloak issuer host; MUST match the token `iss` the edge verifies.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
ZONE2_LOG_LEVEL=INFO
# Which vendor module(s) load (comma-separated "pkg.path:ClassName").
ZONE2_ENABLED_USE_CASE_MODULES=zone2.plugins.demo.module:DemoModule,zone2.plugins.nhs.module:NhsModule

# ── Zone 1 edge (the containerised edge in this overlay) ──────────────────────
ZONE1_LOG_LEVEL=INFO
ZONE1_MODEL=gemma4:e4b-it-q4_K_M
# Local transport secret the CLI sends (X-Host-Secret) — NOT identity.
ZONE1_HOST_SECRET=dev-secret
