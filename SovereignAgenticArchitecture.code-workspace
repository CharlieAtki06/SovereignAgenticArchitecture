{
  "folders": [
    {
      "name": "Root — Sovereign Agentic Architecture",
      "path": "."
    },
    {
      "name": "Edge — Zone 1",
      "path": "../SovereignAgenticArchitectureZoneOne"
    },
    {
      "name": "Governance Gateway — Zone 2",
      "path": "../Sovereign-Agentic-Architecture/SovereignAgenticArchitectureZoneTwo"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/__pycache__": true,
      "**/.venv": true,
      "**/.mypy_cache": true,
      "**/.ruff_cache": true,
      "**/.pytest_cache": true,
      "**/.import_linter_cache": true,
      "**/.docusaurus": true,
      "**/portal/build": true,
      "**/portal/node_modules": true
    },
    "search.exclude": {
      "**/__pycache__": true,
      "**/.venv": true,
      "**/*.lock": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.pylance",
      "charliermarsh.ruff",
      "ms-python.mypy-type-checker",
      "likec4.likec4-vscode"
    ]
  }
}
